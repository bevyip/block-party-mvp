{
  "devCommand": "vite",
  "rewrites": [
    {
      "source": "/generated-sprites/:path*",
      "destination": "/api/generated-sprite-proxy?path=:path*"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/pipeline", "destination": "/pipeline.html" },
    { "source": "/pipeline/", "destination": "/pipeline.html" },
    { "source": "/sprites", "destination": "/sprites.html" },
    { "source": "/sprites/", "destination": "/sprites.html" },
    { "source": "/map", "destination": "/index.html" },
    { "source": "/map/", "destination": "/index.html" },
    { "source": "/map.html", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    {
      "source": "/((?!api/)(?!assets/)(?!cards/)(?!generated-sprites/)(?!sounds/).*)",
      "destination": "/index.html"
    }
  ]
}
